# Knitting site deployment — copy to Vercel env vars (knitting project)
# Use the SAME admin credentials as your embroidery site.

MONGODB_URI=mongodb+srv://...
DB_NAME=knitting_inventory
SESSION_SECRET=generate-a-unique-secret-for-knitting

# Same as embroidery Vercel project
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here

# Tenant configuration
TENANT_ID=knitting
APP_TITLE=Knitting Inventory
ENABLED_TABS=projects,inventory,wip,completed,sales,reports
DEFAULT_SHOP_CUSTOMER=Flippin' Happy
HIDE_TAGS=true
PARTNER_USERNAME=akeeler

# Embroidery site only — link to knitting site in header
# KNITTING_SITE_URL=https://your-knitting-app.vercel.app
